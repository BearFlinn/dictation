#!/usr/bin/env bash
# On-demand control for the speech stack: the speech-asr and speech-llm
# servers plus the Voxtype dictation daemon. `speech stop` frees all GPU memory.
set -euo pipefail
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/common.sh"

start() {
    start_servers
    if ! is_active "$VOX_UNIT"; then
        systemctl --user reset-failed "$VOX_UNIT" 2>/dev/null || true
        systemd-run --user --quiet --unit="$VOX_UNIT" --collect \
            --setenv=WAYLAND_DISPLAY --setenv=XDG_RUNTIME_DIR \
            --setenv=HYPRLAND_INSTANCE_SIGNATURE --setenv=DBUS_SESSION_BUS_ADDRESS \
            --setenv=PATH \
            voxtype daemon
    fi
    printf 'Waiting for the speech servers'
    if wait_for_servers; then
        echo " ready."
        echo "Press SUPER+D to start dictating, press again to stop."
        notify "Speech" "Ready: SUPER+D starts and stops dictation"
    else
        echo " failed. Check: speech logs" >&2
        notify "Speech" "Servers failed to start; check 'speech logs'"
        return 1
    fi
}

stop() {
    systemctl --user stop "$VOX_UNIT" 2>/dev/null || true
    stop_servers
    echo "Speech stopped."
}

status() {
    local u
    for u in "$ASR_UNIT" "$LLM_UNIT" "$VOX_UNIT"; do
        printf '%-16s %s\n' "$u" "$(systemctl --user is-active "$u" 2>/dev/null || true)"
    done
}

toggle() {
    if is_active "$VOX_UNIT" || is_active "$ASR_UNIT" || is_active "$LLM_UNIT"; then
        stop
        notify "Speech" "Stopped"
    else
        notify "Speech" "Starting…"
        start
    fi
}

# Waybar custom module: prints one JSON status line every half second.
waybar_status() {
    local state icon tooltip
    while true; do
        if ! is_active "$VOX_UNIT"; then
            state=off icon="󰍭" tooltip="Speech off (click to start)"
        elif ! servers_ready; then
            state=starting icon="󰔟" tooltip="Speech starting…"
        else
            state="$(timeout 2 voxtype status --format json 2>/dev/null | jq -r '.alt // "idle"')"
            case "$state" in
                recording) icon="󰍬" tooltip="Recording (SUPER+D to stop)" ;;
                transcribing) icon="󰔟" tooltip="Transcribing…" ;;
                *) state=idle icon="󰍬" tooltip="Speech ready (SUPER+D to dictate, click to stop)" ;;
            esac
        fi
        jq -cn --arg t "$icon" --arg c "$state" --arg tt "$tooltip" \
            '{text: $t, alt: $c, class: $c, tooltip: $tt}'
        sleep 0.5
    done
}

case "${1:-}" in
    start) start ;;
    stop) stop ;;
    restart) stop; start ;;
    toggle) toggle ;;
    status) status ;;
    logs) shift; journalctl --user -u "$ASR_UNIT" -u "$LLM_UNIT" -u "$VOX_UNIT" -n 50 --no-pager "$@" ;;
    waybar) waybar_status ;;
    *) echo "usage: speech {start|stop|restart|toggle|status|logs [-f]|waybar}" >&2; exit 2 ;;
esac
