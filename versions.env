# Pinned versions for install.sh. Check upstream before bumping.

# Dictation front end (hotkey, recording, typing). Transcription goes to the
# speech-asr server through Voxtype's OpenAI-compatible remote backend.
VOXTYPE_VERSION=1.1.1
VOXTYPE_SIGNING_KEY=9CCF7915B750CAE8B095ED1AA3FC9F33FD209279

# speech-asr: CrispASR serves Cohere Transcribe (words), Nemotron 3
# Diarization (who spoke when) and Silero VAD over one HTTP API.
CRISPASR_VERSION=0.8.43
CRISPASR_SHA256=fea397a3d7eb13741e3c65027fb1f51d0b362f9098257fbfe2d0e97e6c4fdf54
COHERE_REPO=cstr/cohere-transcribe-03-2026-GGUF
COHERE_REVISION=4e98a8c31c95a92d651e60e3bfae4fe29fc6e026
COHERE_FILE=cohere-transcribe.gguf
DIAR_REPO=nvidia/Nemotron-3-Diarization
DIAR_REVISION=f667ed73aee57d40cc39428eb768b4fd87a0a29e
DIAR_FILE=Nemotron-3-Diarization.q8_0.gguf
VAD_REPO=ggml-org/whisper-vad
VAD_REVISION=9ffd54a1e1ee413ddf265af9913beaf518d1639b
VAD_FILE=ggml-silero-v6.2.0.bin

# speech-llm: llama.cpp serves Gemma for dictation cleanup and meeting summaries.
LLAMA_CPP_BUILD=b11719
LLAMA_CPP_CUDA=12.8
GEMMA_REPO=ggml-org/gemma-4-E4B-it-GGUF
GEMMA_REVISION=a69f018d7678a2b9f5e705f8903d6fb29b9b25dc
GEMMA_FILE=gemma-4-E4B-it-Q8_0.gguf

# CUDA 13 runtime and cuBLAS for CrispASR's CUDA 13 build (the one with RTX
# 50-series kernels), taken from NVIDIA's PyPI wheels as "url sha256".
CUDA_WHEELS=(
