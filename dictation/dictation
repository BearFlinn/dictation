#!/usr/bin/env bash
# On-demand control for the dictation stack. Runs the Gemma cleanup server and
# the Voxtype daemon as transient systemd user units, so nothing starts at
# login and `dictation stop` frees all GPU memory.
set -euo pipefail

REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
source "$REPO/versions.env"

PORT="${DICTATION_LLM_PORT:-8090}"
LLM_UNIT=dictation-llm
VOX_UNIT=dictation-voxtype
LLAMA_DIR="$REPO/vendor/llama.cpp-$LLAMA_CPP_BUILD"

notify() {
    if command -v notify-send >/dev/null; then
        notify-send -a dictation "Dictation" "$1" || true
    fi
}

is_active() { systemctl --user is-active --quiet "$1"; }

start() {
    if ! is_active "$LLM_UNIT"; then
        systemctl --user reset-failed "$LLM_UNIT" 2>/dev/null || true
        systemd-run --user --quiet --unit="$LLM_UNIT" --collect \
            --setenv=LD_LIBRARY_PATH="$LLAMA_DIR" \
            "$LLAMA_DIR/llama-server" \
            --model "$REPO/models/$GEMMA_FILE" \
            --host 127.0.0.1 --port "$PORT" \
            --n-gpu-layers 999 --ctx-size 4096 --parallel 1 \
            --reasoning-budget 0
    fi
    if ! is_active "$VOX_UNIT"; then
        systemctl --user reset-failed "$VOX_UNIT" 2>/dev/null || true
        # Voxtype's ONNX CUDA 13 build runs Cohere's encoder on the GPU. It
        # loads its ONNX Runtime plugins from its own directory, so run the
        # copy in cuda-13/, with the CUDA libraries from vendor/cuda13-libs.
        systemd-run --user --quiet --unit="$VOX_UNIT" --collect \
            --setenv=WAYLAND_DISPLAY --setenv=XDG_RUNTIME_DIR \
            --setenv=HYPRLAND_INSTANCE_SIGNATURE --setenv=DBUS_SESSION_BUS_ADDRESS \
            --setenv=PATH \
            --setenv=LD_LIBRARY_PATH="$REPO/vendor/cuda13-libs" \
            /usr/lib/voxtype/cuda-13/voxtype-onnx-cuda-13 daemon
    fi

    printf 'Waiting for the cleanup model'
    for _ in $(seq 60); do
        if curl -fs "http://127.0.0.1:$PORT/health" >/dev/null 2>&1; then
            echo " ready."
            echo "Press SUPER+D to start dictating, press again to stop."
            notify "Ready: SUPER+D starts and stops recording"
            return 0
        fi
        is_active "$LLM_UNIT" || break
        printf '.'
        sleep 1
    done
    echo " failed. Check: dictation logs" >&2
    notify "Cleanup model failed to start; dictation will type raw text"
    return 1
}

stop() {
    systemctl --user stop "$VOX_UNIT" "$LLM_UNIT" 2>/dev/null || true
    echo "Dictation stopped."
}

status() {
    local u
    for u in "$LLM_UNIT" "$VOX_UNIT"; do
        printf '%-18s %s\n' "$u" "$(systemctl --user is-active "$u" 2>/dev/null || true)"
    done
}

logs() { journalctl --user -u "$LLM_UNIT" -u "$VOX_UNIT" -n 50 --no-pager "$@"; }

toggle() {
    if is_active "$VOX_UNIT" || is_active "$LLM_UNIT"; then
        stop
        notify "Stopped"
    else
        notify "Starting…"
        start
    fi
}

# Waybar custom module: prints one JSON status line every half second.
waybar_status() {
    local state icon tooltip
    while true; do
        if ! is_active "$VOX_UNIT"; then
            state=off icon="󰍭" tooltip="Dictation off (click to start)"
        elif ! curl -fs --max-time 1 "http://127.0.0.1:$PORT/health" >/dev/null 2>&1; then
            state=starting icon="󰔟" tooltip="Dictation starting…"
        else
            state="$(timeout 2 voxtype status --format json 2>/dev/null | jq -r '.alt // "idle"')"
            case "$state" in
                recording) icon="󰍬" tooltip="Recording (SUPER+D to stop)" ;;
                transcribing) icon="󰔟" tooltip="Transcribing…" ;;
                *) state=idle icon="󰍬" tooltip="Dictation ready (SUPER+D to record, click to stop)" ;;
            esac
        fi
        jq -cn --arg t "$icon" --arg c "$state" --arg tt "$tooltip" \
            '{text: $t, alt: $c, class: $c, tooltip: $tt}'
        sleep 0.5
    done
}

case "${1:-}" in
    start) start ;;
    stop) stop ;;
    restart) stop; start ;;
    toggle) toggle ;;
    status) status ;;
    logs) shift; logs "$@" ;;
    waybar) waybar_status ;;
    *) echo "usage: dictation {start|stop|restart|toggle|status|logs [-f]|waybar}" >&2; exit 2 ;;
esac
